# Required project roots. Copy to a local shell configuration and edit paths.
export CRC_ROOT=/path/to/CRC
export CRC_STUDY_ROOT="$CRC_ROOT/05_isoform_main_study"
export CRC_V2_ROOT="$CRC_STUDY_ROOT/10_crc_NAT_isoform_remodeling_manuscript_v2_20260709"

# Reference inputs for the portable upstream wrappers.
export REFERENCE_FASTA=/path/to/GRCh38.p14.genome.fa
export REFERENCE_GTF=/path/to/gencode.v48.annotation.gtf
export STAR_GENOME_DIR=/path/to/gencode.v48_STAR_INDEX
export SQANTI3_DIR=/path/to/SQANTI3
export SQANTI3_POLYA_MOTIFS="$SQANTI3_DIR/data/polyA_motifs/mouse_and_human.polyA_motif.txt"
export CRC_FIG3_ROBUSTNESS_ROOT=/path/to/frozen/Figure3_measurement_robustness_results

# Required only for the ORF/domain annotation script.
export CRC_ORF_ENV=/path/to/conda/envs/crc_orf_anno
export CONDA_ENVS_DIR=/path/to/conda/envs
export SOFTWARE_ROOT=/path/to/software
export CONDA_BIN=conda

# Optional executable overrides.
export STAR_BIN=STAR
export FLAIR_BIN=flair
export PYCHOPPER_BIN=pychopper
export SQANTI3_QC_BIN="$SQANTI3_DIR/sqanti3_qc.py"
export SQANTI3_FILTER_BIN="$SQANTI3_DIR/sqanti3_filter.py"
export SQANTI3_RESCUE_BIN="$SQANTI3_DIR/sqanti3_rescue.py"
export PYTHON_BIN=python
export SAMTOOLS_BIN=samtools
export R_SCRIPT_BIN=Rscript

# Optional workflow resource controls.
export PYCHOPPER_THREADS=20
export STAR_THREADS=8
export FLAIR_THREADS=8
export FLAIR_QUANT_THREADS=16
export SQANTI3_CPUS=24
export SQANTI3_CHUNKS=1
